# Generate an ignored local file with: node ops/setup-env.mjs
# Supply deployment-specific values through your secret configuration.
NODE_ENV=development
PORT=3000
WEBHOOK_SECRET_ENCRYPTION_KEY=
SETTLEMENT_INTERNAL_TOKEN=
ACQUIRER_CALLBACK_SIGNING_SECRET=
# No messages are sent by the development transport; no OTP values are logged.
OTP_DELIVERY_TRANSPORT=development
# Production requires resend, a verified sender address and a sending API key.
OTP_EMAIL_FROM=
OTP_RESEND_API_KEY=
OTP_DELIVERY_TIMEOUT_MS=5000
# Apply migration 0085 before enabling; use a dedicated secret-manager key.
FEATURE_TOTP=false
TOTP_SECRET_ENCRYPTION_KEY=
