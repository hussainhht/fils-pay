FROM node:22-bookworm-slim
WORKDIR /app
COPY . .
RUN npm ci --no-audit --no-fund
RUN npm run typecheck
ARG VITE_WEB_BASE_URL
RUN VITE_API_BASE_URL= npm run build -w @filspay/web
RUN VITE_ADMIN_API_BASE_URL= VITE_WEB_BASE_URL="$VITE_WEB_BASE_URL" npm run build -w @filspay/admin
CMD ["node", "--import", "tsx", "apps/api/src/index.ts"]
